<?xml version="1.0" encoding="utf-8"?>
<!--
  Consult360 OPD Module - ASP.NET Web Forms, .NET Framework 4.8
  Server-rendered pages + C# code-behind. Data comes from the DOCNyle web API (SERVICE_URL) per module, or from the
  in-memory demo store for modules set to InProc (see DataSource:* below). No database connection strings here.
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>
  <!-- Vendor credentials (VendorId / VendorPwd) are NOT kept here: they are read from App_Data\api-secrets.config
       (git-ignored; copy App_Data\api-secrets.example.config and fill it in). Keys in that file override these. -->
  <appSettings file="App_Data\api-secrets.config">
    <!-- DOCNyle web API (API_Jamaica_Consult360.xlsx): JSON over GET/POST, hashValue = SHA-256(HospitalId + UserId), SessionToken header -->
    <add key="SERVICE_URL" value="https://jamaicastagewebapi.docnyle.in/stagewebapi_jamaica.svc" />
    <add key="VendorId" value="" />
    <add key="VendorPwd" value="" />
    <add key="ApiTimeoutSeconds" value="30" />
    <!-- Lifetime of the service session created at sign-in (CreateUserSession ExpiresAt); idle timeout is sessionState below -->
    <add key="ApiSessionHours" value="12" />
    <!-- Data source per module (API-INTEGRATION-GUIDE.md §4.1/§6): Api = DOCNyle web API, InProc = in-memory demo data.
         Switch modules together in the cut-over order (Users+Hospital, Patients, Scheduling, Consultation+Catalog+Lab+Inventory+
         ConsultationConfig+UserNotifications, Billing, Operations); with every module on Api the demo data is not loaded. -->
    <add key="DataSource:Users" value="Api" />
    <add key="DataSource:Hospital" value="Api" />
    <add key="DataSource:Patients" value="Api" />
    <add key="DataSource:Scheduling" value="Api" />
    <add key="DataSource:Consultation" value="Api" />
    <add key="DataSource:Catalog" value="Api" />
    <add key="DataSource:Lab" value="Api" />
    <add key="DataSource:Inventory" value="Api" />
    <add key="DataSource:Billing" value="Api" />
    <add key="DataSource:Operations" value="Api" />
    <add key="DataSource:ConsultationConfig" value="Api" />
    <add key="DataSource:UserNotifications" value="Api" />
    <!-- Display only on anonymous pages (login, patient portal): the portal operations take the hospital from the service's configuration -->
    <add key="PortalHospitalId" value="" />
    <!-- Demo account list on the login page (dev/test only) -->
    <add key="ShowDemoLogins" value="false" />
    <!-- Classic (non-jQuery) client-side script for the ASP.NET validator controls -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- 51200 KB: lab partners upload result reports (up to 10 files × 20 MB checked per file in LabService) -->
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-IN" uiCulture="en" />
    <customErrors mode="Off" />
    <!-- Signed-in user context lives in session; 15 minutes of inactivity signs the user out -->
    <sessionState mode="InProc" timeout="15" />
    <pages enableViewState="true" validateRequest="true" clientIDMode="Predictable" controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="OpdProject.Models" />
        <add namespace="OpdProject.Services" />
        <add namespace="OpdProject.Web" />
      </namespaces>
      <controls>
        <!-- <c360:PhoneValidator> — the hospital's phone rule (Jamaican numbers for a Jamaican hospital) -->
        <add tagPrefix="c360" namespace="OpdProject.Web" assembly="OpdProject" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Must match httpRuntime maxRequestLength (bytes here, KB there) -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <modules>
      <!-- Friendly URLs (/patients, /consultation/patient/PAT-001, …) via System.Web.Routing -->
      <remove name="UrlRoutingModule-4.0" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
    </modules>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Tabler icon font (assets/icons/tabler-icons.min.css). remove+add avoids
           duplicate-entry errors on IIS versions that already define these types. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
    </staticContent>
  </system.webServer>
</configuration>
