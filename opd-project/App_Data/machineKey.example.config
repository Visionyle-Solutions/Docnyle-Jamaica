<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to machineKey.config and fill in random hex keys (validationKey: 128 hex chars, decryptionKey: 64 hex chars).
     Every server running the site must use the same keys, and they must not change between deploys, or users are
     signed out and open pages fail to post back. -->
<machineKey validationKey="REPLACE_WITH_128_HEX_CHARS" decryptionKey="REPLACE_WITH_64_HEX_CHARS" validation="HMACSHA256" decryption="AES" />
